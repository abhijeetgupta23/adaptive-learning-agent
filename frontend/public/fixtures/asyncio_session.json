      "method": "game",
      "content": "<div id=\"sched\"><style>#sched{font-family:ui-monospace,monospace;background:#0d1117;color:#c9d1d9;padding:14px;min-height:380px;border-radius:8px}#sched h2{margin:0 0 4px;color:#58a6ff;font-size:1.05em}#sched .sub{color:#8b949e;font-size:.78em;margin-bottom:10px}#sched .panels{display:flex;gap:8px;flex-wrap:wrap}#sched .col{flex:1;min-width:160px;background:#161b22;border:1px solid #30363d;border-radius:6px;padding:8px}#sched .col h3{margin:0 0 6px;font-size:.7em;text-transform:uppercase;letter-spacing:1px;color:#8b949e}#sched .task{display:flex;justify-content:space-between;padding:5px 8px;margin:3px 0;border-radius:4px;font-size:.82em;border:1px solid #30363d;background:#21262d}#sched .task.ready{border-color:#238636;color:#3fb950}#sched .task.running{border-color:#d29922;color:#e3b341}#sched .task.done{border-color:#30363d;color:#484f58;text-decoration:line-through}#sched .ctrl{margin-top:10px;display:flex;gap:6px;flex-wrap:wrap}#sched button{background:#1f6feb;color:#fff;border:none;padding:6px 12px;border-radius:5px;font-family:inherit;font-size:.82em;cursor:pointer}#sched button:hover{background:#388bfd}#sched button:disabled{opacity:.4;cursor:not-allowed}#sched .log{margin-top:8px;font-size:.74em;color:#8b949e;background:#0d1117;border:1px solid #21262d;border-radius:5px;padding:6px;max-height:90px;overflow-y:auto}#sched .empty{color:#484f58;font-size:.78em;font-style:italic}</style><h2>⚡ Coroutine Scheduler</h2><div class=\"sub\">Drive the loop — add coroutines, run the next one, watch them suspend.</div><div class=\"panels\"><div class=\"col\"><h3>Ready</h3><div id=\"ready\"></div></div><div class=\"col\"><h3>Running</h3><div id=\"running\"></div></div><div class=\"col\"><h3>Done</h3><div id=\"done\"></div></div></div><div class=\"ctrl\"><button id=\"add\">+ Add coro</button><button id=\"run\">▶ Run next</button><button id=\"reset\">↻ Reset</button></div><div class=\"log\" id=\"log\">Ready queue is FIFO. \"Run next\" pops the head, runs it, suspends it back to ready.</div><script>(function(){const names=['fetch','parse','render','tick','poll','flush','sync'];const state={ready:[],running:null,done:[],n:0,steps:0};const $=id=>document.getElementById(id);function log(m){const l=$('log');const d=document.createElement('div');d.textContent='› '+m;l.appendChild(d);l.scrollTop=l.scrollHeight;}function render(){const r=$('ready'),rn=$('running'),dn=$('done');r.innerHTML='';rn.innerHTML='';dn.innerHTML='';if(state.ready.length===0)r.innerHTML='<div class=\"empty\">empty</div>';if(!state.running)rn.innerHTML='<div class=\"empty\">idle</div>';if(state.done.length===0)dn.innerHTML='<div class=\"empty\">none</div>';state.ready.forEach((t,i)=>{const d=document.createElement('div');d.className='task ready';d.innerHTML='<span>'+t.name+'</span><span>'+t.uses+'/'+t.budget+'</span>';r.appendChild(d);});if(state.running){const d=document.createElement('div');d.className='task running';d.innerHTML='<span>'+state.running.name+'</span><span>'+state.running.uses+'/'+state.running.budget+'</span>';rn.appendChild(d);}state.done.forEach(t=>{const d=document.createElement('div');d.className='task done';d.innerHTML='<span>'+t.name+'</span><span>done</span>';dn.appendChild(d);});}$('add').addEventListener('click',()=>{const nm=names[state.n%names.length]+'_'+(state.n+1);state.ready.push({name:nm,uses:0,budget:2+Math.floor(Math.random()*3)});state.n++;log('queued '+nm+' (FIFO tail)');render();});$('run').addEventListener('click',()=>{if(state.running){state.running.uses++;if(state.running.uses>=state.running.budget){state.done.push(state.running);log('✓ '+state.running.name+' finished');state.running=null;}else{state.ready.push(state.running);log(state.running.name+' awaited → back to ready (uses '+state.running.uses+'/'+state.running.budget+')');state.running=null;}}if(!state.running&&state.ready.length>0){state.running=state.ready.shift();state.steps++;log('▶ step '+state.steps+': running '+state.running.name);}render();});$('reset').addEventListener('click',()=>{state.ready=[];state.running=null;state.done=[];state.n=0;state.steps=0;log('reset — try queueing 3 coros and running them in order');render();});render();})();</script></div>"
